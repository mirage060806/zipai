ZIPAI_BASE_URL=http://localhost:8080
PROPERTY_IMPORT_TOKEN=replace-with-local-secret
PROPERTY_CRAWL_TIMEOUT_SECONDS=20

# 현재 매물 주소 좌표 변환 설정
PROPERTY_LISTING_GEOCODE_LIMIT=500
PROPERTY_LISTING_GEOCODE_DELAY_SECONDS=0.25

# 현재 매물 CSV/JSON 예약 Import
PROPERTY_LISTING_SOURCE_NAME=AUTHORIZED_BROKER_CSV
# 공급처의 전체 매물 파일임이 확실할 때만 true
PROPERTY_LISTING_COMPLETE_SNAPSHOT=false
# 실제 공급처 파일은 false, 학습용 파일만 true
PROPERTY_LISTING_STUDY_DATA=false
