# 공통
ZIPAI_BASE_URL=http://localhost:8080
PROPERTY_IMPORT_TOKEN=replace-with-local-secret
PROPERTY_CRAWL_TIMEOUT_SECONDS=20
PROPERTY_IMPORT_BATCH_SIZE=500
PROPERTY_UPLOAD_RETRIES=3
PROPERTY_UPLOAD_RETRY_DELAY_SECONDS=3

# ============================================================
# 권장: 국토교통부 공식 아파트 매매 실거래가 API
# 활성 매물이 아니라 '최근 실거래 참고 데이터'로 별도 저장됩니다.
# ============================================================
PROPERTY_SOURCE_MODE=molit
MOLIT_SERVICE_KEY=your-data-go-kr-service-key
# auto: %2B/%2F 등이 있으면 Encoding 키로 판단, 아니면 Decoding 키로 판단
# 필요 시 decoded 또는 encoded로 강제 지정
MOLIT_SERVICE_KEY_FORMAT=auto
MOLIT_LAWD_CD=41117
# 비워두면 현재 YYYYMM 사용
MOLIT_DEAL_YMD=
MOLIT_NUM_OF_ROWS=1000
# 좌표 변환은 연속 실패 횟수에 도달하면 중단하고 좌표 없는 상태로 업로드합니다.
MOLIT_GEOCODE_LIMIT=200
MOLIT_GEOCODE_TIMEOUT_SECONDS=5
MOLIT_GEOCODE_MAX_SECONDS=300
MOLIT_GEOCODE_FAILURE_LIMIT=10
# --geocode-only 실행 시에도 위 제한만큼 좌표를 보완하고 체크포인트에 진행 위치를 저장합니다.
# 좌표 누락이 남으면 같은 명령을 다시 실행하여 저장 지점부터 계속할 수 있습니다.

