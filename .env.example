# ZipAI local environment variables
# Copy this file to .env and fill in your own values.

# Database
# Local MySQL example. Render/TiDB uses the TLS JDBC URL supplied by the provider.
DB_URL='jdbc:mysql://localhost:3306/zipai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8'
DB_USERNAME=zipai
DB_PASSWORD=

VWORLD_API_KEY=

# Property / MOLIT
PROPERTY_SOURCE_MODE=molit
MOLIT_SERVICE_KEY=
MOLIT_LAWD_CD=41117
# single: MOLIT_LAWD_CD 한 곳 / capital: 서울·경기 전체
MOLIT_REGION_SCOPE=single
# 선택: 쉼표로 지정하면 REGION_SCOPE보다 우선합니다. 예: 11680,11710,41117
MOLIT_LAWD_CDS=
PROPERTY_IMPORT_TOKEN=
FINANCE_IMPORT_TOKEN=
FINANCE_CRAWL_TIMEOUT_SECONDS=20
ZIPAI_BASE_URL=http://localhost:8080

# Social login (키를 입력한 공급자만 *_OAUTH_CONFIGURED=true로 변경)
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CONFIGURED=false
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CONFIGURED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CONFIGURED=false
PROPERTY_IMPORT_BATCH_SIZE=500
MOLIT_GEOCODE_LIMIT=200
MOLIT_GEOCODE_DELAY_SECONDS=0.25
MOLIT_GEOCODE_TIMEOUT_SECONDS=5
MOLIT_GEOCODE_MAX_SECONDS=300

# Optional overrides
SAFETY_DEFAULT_RADIUS_METERS=500
SAFETY_MAX_RADIUS_METERS=2000

# 위험안전도 공공데이터 Import 파일 경로
SAFETY_IMPORT_CSV=rpa/safety/data/processed/police_processed.csv
REGIONAL_SAFETY_INDEX_IMPORT_CSV=rpa/safety/data/processed/regional_safety_index_2025.csv
SEOUL_CRIME_IMPORT_CSV=rpa/safety/data/processed/seoul_police_crime_statistics_2024.csv
WOMEN_SAFE_HOUSE_IMPORT_CSV=rpa/safety/data/processed/seoul_women_safe_houses_2019.csv
GYEONGGI_CRIME_IMPORT_CSV=rpa/safety/data/processed/police_crime_statistics_gyeonggi_2016_2025.csv
GYEONGGI_WOMEN_SAFETY_IMPORT_CSV=rpa/safety/data/processed/gyeonggi_women_safety_facilities_2026-04-14.csv
